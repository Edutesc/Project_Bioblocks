rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Caminho novo: profile_images/{userId}_{timestamp}.jpg (sem subpasta)
    match /profile_images/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Caminho legado: profile_images/{userId}/{arquivo}
    // TODO: remover apos migrar todos os usuarios para o caminho novo
    match /profile_images/{userId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }

    // Bloqueia tudo o mais por padrao
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}